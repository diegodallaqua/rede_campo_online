@startuml activity_diagram

skinparam swimlaneWidth 280
skinparam defaultTextAlignment center
skinparam activityBackgroundColor #FEFEFE
skinparam activityBorderColor #888888
skinparam activityFontSize 13

|#D6EAF8|Público Geral|
|#D5F5E3|Pesquisador|
|#FDEBD0|Administrador|

start

' ═══════════════════════════════════════════════════════════════
' PÚBLICO GERAL
' ═══════════════════════════════════════════════════════════════

|Público Geral|
:Acessa o portal;

repeat
  switch (Seleciona conteúdo)
  case (Notícias)
    :Consulta Notícias;
  case (Projetos / Eventos)
    :Consulta Projetos;
    :Consulta Eventos do Projeto;
  case (Publicações)
    :Consulta Publicações\n(Artigos, Livros,\nCapítulos de Livro, Teses);
  case (Membros)
    :Consulta Membros da Equipe;
  case (Institucional)
    :Consulta Página Institucional;
  endswitch
repeat while (Continuar navegando?) is (sim)
->não;

stop

' ═══════════════════════════════════════════════════════════════
' PESQUISADOR
' ═══════════════════════════════════════════════════════════════

|Pesquisador|
:Acessa o portal;
:Realiza Login;

if (Credenciais válidas?) then (sim)

  repeat
    switch (Seleciona módulo)
    case (Projetos / Eventos)
      :Gerencia Projetos\n<i>(Criar / Editar / Excluir)</i>;
      :Gerencia Eventos\n<i>(Criar / Editar / Excluir)</i>;
    case (Publicações)
      :Gerencia Publicações\n<i>Artigos · Livros</i>\n<i>Capítulos de Livro · Teses</i>\n<i>(Criar / Editar / Excluir)</i>;
    endswitch
  repeat while (Continuar na sessão?) is (sim)
  ->não;

  :Encerra Sessão;

else (não)
  :Exibe erro de autenticação;
  :Redireciona para Login;
endif

stop

' ═══════════════════════════════════════════════════════════════
' ADMINISTRADOR
' ═══════════════════════════════════════════════════════════════

|Administrador|
:Acessa o portal;
:Realiza Login;

if (Credenciais válidas?) then (sim)

  repeat
    switch (Seleciona módulo)
    case (Projetos / Eventos)
      :Gerencia Projetos\n<i>(Criar / Editar / Excluir)</i>;
      :Gerencia Eventos\n<i>(Criar / Editar / Excluir)</i>;
    case (Publicações)
      :Gerencia Publicações\n<i>Artigos · Livros</i>\n<i>Capítulos de Livro · Teses</i>\n<i>(Criar / Editar / Excluir)</i>;
    case (Notícias)
      :Gerencia Notícias\n<i>(Criar / Editar / Excluir)</i>;
    case (Institucional)
      :Gerencia Página Institucional;
    case (Membros / Config.)
      :Gerencia Membros\n<i>(Criar / Editar / Excluir)</i>;
      :Gerencia Funções de Membro;
      :Gerencia Organizações;
      :Gerencia Áreas de Pesquisa;
    endswitch
  repeat while (Continuar na sessão?) is (sim)
  ->não;

  :Encerra Sessão;

else (não)
  :Exibe erro de autenticação;
  :Redireciona para Login;
endif

stop

@enduml
